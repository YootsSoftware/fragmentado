FG_ADMIN_SECRET=change-me-long-random-secret
# Required only to create the first admin account in production.
FG_ADMIN_SETUP_SECRET=change-me-different-long-random-secret
# Optional: set false if your deployment is not serving fg-admin over HTTPS.
FG_ADMIN_COOKIE_SECURE=true
# Optional: force cookie domain when behind redirects/proxy (e.g. fragmentado.yootsmusic.com)
FG_ADMIN_COOKIE_DOMAIN=

# Optional: persistent directory for uploaded audio or video files.
FG_UPLOADS_DIR=

MONGODB_URI=
MONGODB_DB_NAME=fragmentado

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_ARTIST_ID=
SPOTIFY_MARKET=MX
